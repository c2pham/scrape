{
  "manifest_version": 3,
  "name": "MLS & Realtor.com Scraper",
  "version": "1.1.0",
  "description": "Scrapes realtor information from MLS, Realtor.com, and LoopNet listings for homes built this year and closed land lots",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.realtor.com/*",
    "https://*.realtor.com/*",
    "https://www.loopnet.com/*",
    "https://*.loopnet.com/*",
    "*://*.mlslistings.com/*",
    "*://*.mls.com/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.realtor.com/*",
        "https://*.realtor.com/*"
      ],
      "js": ["content-realtor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.loopnet.com/*",
        "https://*.loopnet.com/*"
      ],
      "js": ["content-loopnet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.mlslistings.com/*",
        "*://*.mls.com/*"
      ],
      "js": ["content-mls.js"],
      "run_at": "document_idle"
    }
  ]
}
