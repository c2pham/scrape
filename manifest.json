{
  "manifest_version": 3,
  "name": "MLS & Realtor.com Scraper",
  "version": "1.0.0",
  "description": "Scrapes realtor information from MLS and Realtor.com listings for homes built this year and closed land lots",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.realtor.com/*",
    "https://*.realtor.com/*",
    "*://*.mlslistings.com/*",
    "*://*.mls.com/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.realtor.com/*",
        "https://*.realtor.com/*"
      ],
      "js": ["content-realtor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.mlslistings.com/*",
        "*://*.mls.com/*"
      ],
      "js": ["content-mls.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
